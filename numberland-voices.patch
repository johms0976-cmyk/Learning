+const NL = require(path.join(R, 'js/numberland-data.js'));
+
 /* the games' own slug(), copied from js/wordland-audio.js */
 const slug = s => String(s).toLowerCase().trim()
   .replace(/['’.,!?]/g, '').replace(/\s+/g, '-')
@@ -166,6 +172,77 @@ NAMES.forEach(n => add('names', nameSlug(n), {
   say: n, from: 'name library', note: 'said on its own, finished — it lands after a rising line'
 }));
 
+/* ── 9. NUMBER LAND ───────────────────────────────────────────
+   Nothing here is a new folder. Number Land speaks through
+   WLAudio, so a number word is words/seven.mp3 and a bit of
+   praise is praise/well-counted.mp3, exactly as in the reading
+   games. Everything below therefore lands in the four voice
+   packs on the next run with no other change. */
+
+/* The number words, zero to twenty. Most of the small ones are
+   already here from the reading maps — eleven upwards are not,
+   and those are the ones a counting game leans on hardest. */
+NL.WORD.forEach((w, n) => word(w, 'Number Land \u00b7 the number ' + n));
+
+/* Zib's nudges, when a count comes out wrong. */
+NL.NUDGE.forEach(l => add('phrases', slug(l), {
+  say: l, from: 'Number Land \u00b7 nudge', note: null
+}));
+
+/* Number Land praise. Same two-halves rule as everywhere else:
+   rising in praise/ so it can run into the child's name, and
+   finished in phrases/ for when no name is recorded. */
+NL.PRAISE.forEach(l => {
+  add('praise', slug(l), {
+    say: l, from: 'Number Land \u00b7 praise',
+    note: 'record RISING — runs into the child\u2019s name'
+  });
+  add('phrases', slug(l), {
+    say: l, from: 'Number Land \u00b7 praise, said on its own',
+    note: 'the finished version — heard when the name is not recorded'
+  });
+});
+
+/* The fixed lines inside js/numberland.js — "Count the empty
+   ones" and friends. Read out of the source so the list cannot
+   fall behind the game.
+
+   Anything built by joining strings together is skipped: "Five
+   and three is eight" is a different sentence every time it is
+   said, so there is no file it could ever be. Those keep coming
+   from the tablet's own voice, which is the right answer for
+   them. */
+const nlSrc = fs.readFileSync(path.join(R, 'js/numberland.js'), 'utf8');
+const STRING = /'(?:[^'\\\n]|\\.)*'|"(?:[^"\\\n]|\\.)*"/g;
+const nlFixed = [], nlComposed = [];
+const callRe = /Say\.(phrase|cheer)\(/g;
+let cm;
+while ((cm = callRe.exec(nlSrc))) {
+  /* walk to the matching close paren, ignoring parens in strings */
+  let i = callRe.lastIndex, depth = 1, inStr = null;
+  while (i < nlSrc.length && depth > 0) {
+    const c = nlSrc[i];
+    if (inStr) { if (c === '\\') i++; else if (c === inStr) inStr = null; }
+    else if (c === "'" || c === '"') inStr = c;
+    else if (c === '(') depth++;
+    else if (c === ')') depth--;
+    i++;
+  }
+  const arg = nlSrc.slice(callRe.lastIndex, i - 1);
+  if (/\+/.test(arg)) { nlComposed.push(arg.replace(/\s+/g, ' ')); continue; }
+  (arg.match(STRING) || []).forEach(s => nlFixed.push({ text: eval(s), kind: cm[1] }));
+}
+nlFixed.forEach(({ text, kind }) => {
+  add(kind === 'cheer' ? 'praise' : 'phrases', slug(text), {
+    say: text, from: 'Number Land \u00b7 spoken line',
+    note: kind === 'cheer' ? 'record RISING — runs into the child\u2019s name' : null
+  });
+  if (kind === 'cheer') add('phrases', slug(text), {
+    say: text, from: 'Number Land \u00b7 spoken line, said on its own',
+    note: 'the finished version — heard when the name is not recorded'
+  });
+});
+
